{
  // Controllo dei tipi per le funzioni di Netlify, separato da quello di
  // Next: le funzioni girano su Node, non nel browser, e usano l'oggetto
  // globale Netlify. Si lancia con: npm run typecheck:funzioni
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "types": ["node"]
  },
  "include": ["functions/**/*.mts"]
}
